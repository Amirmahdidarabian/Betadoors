# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# BUSINESS_TIMEZONE: Configured business timezone for Australian operations
BUSINESS_TIMEZONE="Australia/Melbourne"

# SANDBOX_MODE: Explicit indicator that payment, mail, and storage run in local sandbox mode
NEXT_PUBLIC_SANDBOX_MODE="true"
